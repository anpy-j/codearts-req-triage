# ===== CodeArts Req =====
# 项目 ID（devcloud 项目的 32 位 id），必填
HW_PROJECT_ID=
# 区域，默认 cn-north-4
HW_REGION=cn-north-4

# ===== 凭据（环境变量注入，勿提交）=====
# 只读子账号（轮询/详情），至少提供这一把
HW_AK_READ=
HW_SK_READ=
# 写回子账号（最小权限），开启写回时必填
HW_AK_WRITE=
HW_SK_WRITE=
# AddIssueNotes V2 评论接口在部分租户要求 IAM 项目 Token（X-Auth-Token，通常 24 小时有效）
# 仅写在本地 .env；不要发到 issue、日志或提交历史。若 AK/SK 实测可用可留空。
HW_AUTH_TOKEN=

# ===== 轮询 =====
# 缺陷工作项类型（默认 3=Bug）
TRACKER_IDS=3
# 每页条数
POLL_LIMIT=100
# 常驻轮询间隔（秒）
POLL_INTERVAL_SECONDS=300
# 增量游标向前重叠秒数（防边界丢失）
LOOKBACK_SECONDS=60
# 状态文件路径（游标/去重/错误队列）
STATE_FILE=./state.json
# 单条连续失败达到该次数后放弃自动重试（转 poisoned，不再阻塞游标；需人工排查）
MAX_ERROR_ATTEMPTS=5

# ===== 分诊 =====
# 规则文件路径
RULES_FILE=./rules.yaml
# 代码定位：本地代码库 clone 路径（可选；为空则只用关联提交 API）
CODEARTS_REPO_LOCAL_PATH=

# ===== 写回（默认保守）=====
# 总开关：false=只读分诊并打印结论（dry-run 语义）
WRITEBACK_ENABLED=false
# 「AI 分诊」自定义字段名（需先在 Req 项目设置中建好）
TRIAGE_FIELD_NAME=AI分诊
# 是否在 issue 描述末尾追加分诊摘要（带标记，可回滚）
DESCRIPTION_APPEND=true
# 以下自动改字段全部默认关闭，需成员确认 id 映射后开启
AUTO_CHANGE_SEVERITY=false
AUTO_CHANGE_PRIORITY=false
AUTO_CHANGE_MODULE=false
AUTO_CHANGE_ASSIGNEE=false

# ===== Multica 平台联动（同步新 Bug 至 Multica 收件箱）=====
# 总开关：true=分诊后自动在当前 Multica 工作区创建 Issue 并指派
MULTICA_SYNC_ENABLED=true
# Multica 默认接收人用户 ID（从 Multica 用户列表获取）
MULTICA_ASSIGNEE_ID=00000000-0000-0000-0000-000000000000
# 同步最低优先级门槛（P0/P1/P2/P3/P4，P4 代表全量同步）
MULTICA_SYNC_MIN_PRIORITY=P4
# 处理人白名单过滤：逗号分隔的华为云处理人用户名/姓名，为空则接收全部处理人的 Bug
# 例如只接收分配给 dev_user1 的 Bug：
MULTICA_SYNC_HANDLERS=dev_user1
# 华为云处理人 -> Multica 成员 ID 映射表（支持不同处理人的 Bug 路由到 Multica 不同成员收件箱）
MULTICA_HANDLER_MAPPING={"dev_user1": "00000000-0000-0000-0000-000000000000"}
# 缺陷修复完成后的目标合流测试分支（默认 test-cloud，可在定时任务或命令行动态覆盖）
TEST_BRANCH=test-cloud
