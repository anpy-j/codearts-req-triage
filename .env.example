# ===== CodeArts Req =====
# 项目 ID（devcloud 项目的 32 位 id），必填
HW_PROJECT_ID=
# 区域，默认 cn-north-4
HW_REGION=cn-north-4

# ===== 凭据（环境变量注入，勿提交）=====
# 只读子账号（轮询/详情），至少提供这一把
HW_AK_READ=
HW_SK_READ=
# 写回子账号（最小权限），开启写回时必填
HW_AK_WRITE=
HW_SK_WRITE=

# ===== 轮询 =====
# 缺陷工作项类型（默认 3=Bug）
TRACKER_IDS=3
# 每页条数
POLL_LIMIT=100
# 常驻轮询间隔（秒）
POLL_INTERVAL_SECONDS=300
# 增量游标向前重叠秒数（防边界丢失）
LOOKBACK_SECONDS=60
# 状态文件路径（游标/去重/错误队列）
STATE_FILE=./state.json
# 单条连续失败达到该次数后放弃自动重试（转 poisoned，不再阻塞游标；需人工排查）
MAX_ERROR_ATTEMPTS=5

# ===== 分诊 =====
# 规则文件路径
RULES_FILE=./rules.yaml
# 代码定位：本地代码库 clone 路径（可选；为空则只用关联提交 API）
CODEARTS_REPO_LOCAL_PATH=

# ===== 写回（默认保守）=====
# 总开关：false=只读分诊并打印结论（dry-run 语义）
WRITEBACK_ENABLED=false
# 「AI 分诊」自定义字段名（需先在 Req 项目设置中建好）
TRIAGE_FIELD_NAME=AI分诊
# 是否在 issue 描述末尾追加分诊摘要（带标记，可回滚）
DESCRIPTION_APPEND=true
# 以下自动改字段全部默认关闭，需成员确认 id 映射后开启
AUTO_CHANGE_SEVERITY=false
AUTO_CHANGE_PRIORITY=false
AUTO_CHANGE_MODULE=false
AUTO_CHANGE_ASSIGNEE=false
